{
  "name": "capstone-test",
  "version": "1.0.0",
  "description": "Playwright + Cucumber framework for UI and API tests",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ui && npm run test:api",
    "test:ui": "cucumber-js --config cucumber-ui.js",
    "test:api": "cucumber-js --config cucumber-api.js",
    "test:smoke": "npm run test:ui:smoke && npm run test:api:smoke",
    "test:regression": "npm run test:ui:regression && npm run test:api:regression",
    "test:ui:smoke": "cucumber-js --config cucumber-ui.js --tags \"@smoke\"",
    "test:ui:regression": "cucumber-js --config cucumber-ui.js --tags \"@regression\"",
    "test:api:smoke": "cucumber-js --config cucumber-api.js --tags \"@smoke\"",
    "test:api:regression": "cucumber-js --config cucumber-api.js --tags \"@regression\"",
    "test:ui:headed": "PWDEBUG=1 cucumber-js --config cucumber-ui.js",
    "clean": "rimraf dist reports"
  },
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/praveen_merugu/capstone-test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "playwright": "^1.53.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  }
}
